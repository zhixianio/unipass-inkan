// 签名配置（A22：用户从源码自己构建）。这里只放公开的默认值。
// 自己构建时：cp Config/Local.xcconfig.example Config/Local.xcconfig，填上自己的 Team ID 和 Bundle ID 前缀。
// Local.xcconfig 在 .gitignore 里，不要提交。
//
// 不填 Team ID 时用本机签名（Sign to Run Locally）也能运行，但每次重新构建在 macOS 看来都是另一个 App：
// 相机权限会再问一次，上一次构建保存的配对和钥匙串里的提交账户可能读不到。

// 默认前缀是 UniPass 自己的 App ID（xyz.unipass.coordinator），注册在我们的团队下；用自己的团队签名时改成自己的。
BUNDLE_ID_PREFIX = xyz.unipass
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).coordinator

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

// 本机配置（Team ID 等），不进仓库。
#include? "Local.xcconfig"
