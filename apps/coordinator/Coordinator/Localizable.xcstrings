    "None of the signers paired with this Mac is a signer of this Safe, so you can't send from it here. Pair one of its signers first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of the signers paired with this Mac is a signer of this Safe, so you can't send from it here. Pair one of its signers first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和这台 Mac 配对的签名器都不是这个 Safe 的签名人，所以不能在这里从它发送。请先配对它的一台签名器。"
          }
        }
      }
    },
