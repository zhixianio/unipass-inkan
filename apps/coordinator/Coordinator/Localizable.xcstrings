    "Only a Safe created with an official Safe factory, whose signers and threshold haven't changed since, with no modules or guard, and with your paired signer as a signer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a Safe created with an official Safe factory, whose signers and threshold haven't changed since, with no modules or guard, and with your paired signer as a signer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能添加这样的 Safe：用 Safe 官方工厂创建，之后签名人和门限都没改过，没有模块和交易守卫，而且你配对的签名器是它的签名人之一。"
          }
        }
      }
    },
