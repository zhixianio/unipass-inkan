{
  "sourceLanguage": "en",
  "strings": {
    "%@ has at most %lld decimal places.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has at most %lld decimal places."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 最多 %2$lld 位小数。"
          }
        }
      }
    },
    "%@ wei": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wei"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wei"
          }
        }
      }
    },
    "%lld of %lld signers": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld of %lld signers"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld 个签名人中的 %1$lld 个"
          }
        }
      }
    },
    "%lld signer accounts are created on chain in the same transaction.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld signer accounts are created on chain in the same transaction."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一笔交易里会在链上创建 %lld 个签名器账户。"
          }
        }
      }
    },
    "%lld tokens with no balance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tokens with no balance"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个余额为 0 的代币"
          }
        }
      }
    },
    "%lld transactions waiting for signatures or execution": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld transactions waiting for signatures or execution"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 笔交易等待签名或执行"
          }
        }
      }
    },
    "%lld/%lld signatures": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld signatures"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld 签名"
          }
        }
      }
    },
    "A Safe holds your funds. Every transaction from it needs approval from enough of its signers, and your iPhone is one of them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Safe holds your funds. Every transaction from it needs approval from enough of its signers, and your iPhone is one of them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Safe 存放你的资产。每一笔交易都要足够多的签名人批准，你的 iPhone 是其中之一。"
          }
        }
      }
    },
    "A Safe is registered on the signer the first time it signs for it. Removing a Safe here only removes it from this Mac; the Safe and its funds are not affected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Safe is registered on the signer the first time it signs for it. Removing a Safe here only removes it from this Mac; the Safe and its funds are not affected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签名器第一次为某个 Safe 签名时会顺带登记它。在这里移除只是从这台 Mac 上去掉，Safe 本身和里面的资产都不受影响。"
          }
        }
      }
    },
    "A desktop wallet for your Safe that works with an offline signer on your iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A desktop wallet for your Safe that works with an offline signer on your iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Safe 的桌面钱包，和 iPhone 上的离线签名器配合使用。"
          }
        }
      }
    },
    "A small amount is enough, for example 0.01 ETH on %@. It's on the same address on every network. You can top it up or withdraw it any time in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small amount is enough, for example 0.01 ETH on %@. It's on the same address on every network. You can top it up or withdraw it any time in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "少量就够，比如 %@ 上的 0.01 ETH。这个账户在每条网络上都是同一个地址。以后随时可以在设置里充值或转出。"
          }
        }
      }
    },
    "A small wallet on this Mac that puts fully signed transactions on chain and pays their network fee. It is not a signer of your Safe and can't move anything in it. Keep only a little ETH here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small wallet on this Mac that puts fully signed transactions on chain and pays their network fee. It is not a signer of your Safe and can't move anything in it. Keep only a little ETH here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上的一个小钱包，负责把签齐的交易发上链并支付网络费。它不是 Safe 的签名人，动不了 Safe 里的任何东西。这里只放少量 ETH 即可。"
          }
        }
      }
    },
