    "On chain it is now %@ / %lld, not what the Safe was created with. Register it again after changing owners.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On chain it is now %@ / %lld, not what the Safe was created with. Register it again after changing owners."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链上现在是 %@ / %lld，和创建时不同。改过 owner 后要重新登记。"
          }
        }
      }
    },
    "On the other iPhone, open UniPass Inkan Signer and tap “Pair with UniPass Inkan Desktop”, then hold its screen up to this Mac's camera. It is also paired with this Mac, so you can ask it to sign from here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the other iPhone, open UniPass Inkan Signer and tap “Pair with UniPass Inkan Desktop”, then hold its screen up to this Mac's camera. It is also paired with this Mac, so you can ask it to sign from here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在另一台 iPhone 上打开 UniPass Inkan 签名器，点“与 UniPass Inkan 桌面端配对”，再把屏幕对准这台 Mac 的摄像头。它也会和这台 Mac 配对，以后可以从这里让它签名。"
          }
        }
      }
    },
    "On your iPhone, open UniPass Inkan Signer and tap “Pair with UniPass Inkan Desktop”, then hold the screen up to this Mac's camera.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your iPhone, open UniPass Inkan Signer and tap “Pair with UniPass Inkan Desktop”, then hold the screen up to this Mac's camera."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上打开 UniPass Inkan 签名器，点“与 UniPass Inkan 桌面端配对”，再把屏幕对着这台 Mac 的摄像头。"
          }
        }
      }
    },
    "One loop": {
      "localizations": {
        "en": {
