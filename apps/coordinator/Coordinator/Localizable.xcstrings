        }
      }
    },
    "The Safe is on chain but doesn't match what was planned. It was not added.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Safe is on chain but doesn't match what was planned. It was not added."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Safe 已上链，但和计划的不一致，没有添加。"
          }
        }
      }
    },
    "The Safe was created, but it couldn't be checked on chain. Add it with Add Existing Safe once the network is back.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Safe was created, but it couldn't be checked on chain. Add it with Add Existing Safe once the network is back."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Safe 已创建，但没能在链上核对。网络恢复后用「添加已有 Safe」把它加进来。"
          }
        }
      }
    },
    "The address computed from the creation parameters does not match": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address computed from the creation parameters does not match"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按创建参数算出的地址不一致"
          }
        }
      }
    },
    "The address computed from the creation parameters matches (official Safe %@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address computed from the creation parameters matches (official Safe %@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按创建参数算出的地址一致（官方 Safe %@）"
          }
        }
      }
    },
    "The address could not be checked on chain when pairing (network problem). The signer checks that it is an owner when you register a Safe.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address could not be checked on chain when pairing (network problem). The signer checks that it is an owner when you register a Safe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对时没能在链上核对地址（网络问题）。登记 Safe 时签名器会检查自己是不是 owner。"
          }
        }
      }
    },
    "The address from “%@” does not match the one computed on chain (%@). Nothing was saved. Open the pairing page on the signer and scan again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address from “%@” does not match the one computed on chain (%@). Nothing was saved. Open the pairing page on the signer and scan again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」给出的地址和链上算出的不一致（链上是 %2$@），没有保存。请在签名器上重新打开配对页再扫一次。"
          }
        }
      }
    },
    "The address of “%@” does not match its public key on this network. Scan its pairing code again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address of “%@” does not match its public key on this network. Scan its pairing code again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”的地址和它的公钥在这条网络上对不上。请重新扫它的配对码。"
          }
        }
      }
    },
    "The amount is too large.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The amount is too large."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金额太大。"
          }
        }
      }
    },
    "The amount must be more than 0.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The amount must be more than 0."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金额必须大于 0。"
          }
        }
      }
    },
    "The balance is too small to cover the network fee of a transfer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance is too small to cover the network fee of a transfer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "余额太少，不够付一笔转账的网络费。"
          }
        }
      }
    },
    "The blockchain node and Safe's transaction service report different signers or settings for this Safe, so it can't be added. Try again later, or set a different node in Settings › Advanced.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The blockchain node and Safe's transaction service report different signers or settings for this Safe, so it can't be added. Try again later, or set a different node in Settings › Advanced."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "区块链节点和 Safe 交易服务报的这个 Safe 的签名人或设置不一致，所以不能添加。请稍后再试，或者在「设置 › 高级」里换一个节点。"
          }
        }
      }
    },
    "The blockchain node asked for a much higher network fee than this transaction should need, so nothing was signed. Try again later, or set a different node in Settings › Advanced.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The blockchain node asked for a much higher network fee than this transaction should need, so nothing was signed. Try again later, or set a different node in Settings › Advanced."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "区块链节点要求的网络费比这笔交易应有的高得多，所以没有签名。请稍后再试，或者在「设置 › 高级」里换一个节点。"
          }
        }
      }
    },
    "The blockchain node isn't on %@, so nothing was signed. Check the node in Settings › Advanced.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The blockchain node isn't on %@, so nothing was signed. Check the node in Settings › Advanced."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "区块链节点不在 %@ 上，所以没有签名。请在「设置 › 高级」里检查节点。"
          }
        }
      }
    },
    "The camera could not start: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera could not start: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头启动失败：%@"
          }
        }
      }
    },
    "The code didn't come through completely. Scan it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code didn't come through completely. Scan it again."
          }
        },
