    "UniPass Inkan Desktop": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UniPass Inkan Desktop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UniPass Inkan 桌面端"
          }
        }
      }
    },
    "UniPass Inkan Desktop collects and syncs signatures through Safe's official transaction service. It works without a key, limited to 2 requests per second and 5,000 per month; for regular use, get a free key at developer.safe.global. The key is stored only in this Mac's keychain.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UniPass Inkan Desktop collects and syncs signatures through Safe's official transaction service. It works without a key, limited to 2 requests per second and 5,000 per month; for regular use, get a free key at developer.safe.global. The key is stored only in this Mac's keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UniPass Inkan 桌面端通过 Safe 官方的交易服务收集和同步签名。不填 key 也能用，但每秒最多 2 次、每月 5,000 次请求；经常使用时可以在 developer.safe.global 免费申请一个。key 只存在这台 Mac 的钥匙串里。"
          }
        }
      }
    },
