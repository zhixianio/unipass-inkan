    "Another UniPass Inkan Signer joins by showing its pairing code. Hardware and other wallets join by address.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another UniPass Inkan Signer joins by showing its pairing code. Hardware and other wallets join by address."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一台 UniPass Inkan 签名器出示配对码即可加入；硬件钱包和其他钱包按地址加入。"
          }
        }
      }
    },
    "Another signer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another signer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他签名人"
          }
        }
      }
    },
    "Another signer already has this name.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another signer already has this name."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一台签名器已经叫这个名字了。"
          }
        }
      }
    },
    "Another transaction with the same number was executed first, so this one can no longer run.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another transaction with the same number was executed first, so this one can no longer run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一编号的另一笔交易已经先执行了，这一笔不能再执行。"
          }
        }
      }
    },
    "Any %lld of %lld must approve": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any %lld of %lld must approve"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld 个签名人中任意 %1$lld 个同意即可"
          }
        }
      }
    },
    "Any %lld of this Safe's signers that aren't paired with this Mac can move its funds without your iPhone signer. The signer's offline checks don't apply to those transactions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any %lld of this Safe's signers that aren't paired with this Mac can move its funds without your iPhone signer. The signer's offline checks don't apply to those transactions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个 Safe 里没和这台 Mac 配对的签名人，凑够 %lld 个就能动用资金，不经过你的 iPhone 签名器。签名器的离线核对对这些交易不起作用。"
          }
        }
      }
    },
    "Any enrolled face": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any enrolled face"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任意已录入的面容"
          }
        }
      }
    },
    "Any one signer alone can move everything in this Safe. Use this only if you mean it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any one signer alone can move everything in this Safe. Use this only if you mean it."
