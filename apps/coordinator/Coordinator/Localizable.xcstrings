    "Paid by the submitter account. The fee at most is what it must hold to send; usually much less is used.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paid by the submitter account. The fee at most is what it must hold to send; usually much less is used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由提交账户支付。「最多」是发出这笔交易时账户里至少要有的金额，实际花的通常少得多。"
          }
        }
      }
    },
    "Paid by this Mac's submitter account, not from the new Safe.": {
